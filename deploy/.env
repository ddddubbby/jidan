# 环境变量示例：复制为 deploy/.env 后按需修改（.env 不入库，里面的密码不要提交）。
#   cp deploy/.env.example deploy/.env
# 无 Docker：deploy/run-backend.sh（起后端）与 deploy/backup.sh（备份）都读这个 .env。下面的值开箱即是“模拟模式”：
# 带演示数据、好生意用模拟实现，用来试跑与演练。正式上线要改的项在文末“上线前改这些”。

# ---------- 后端 ----------
# 后端监听的端口。站点（nginx，见 deploy/nginx.conf）把 /api 转到 127.0.0.1 的这个端口，改了要一起改。
# 站点自己对外的端口写在 nginx.conf 的 listen 里（默认 80）。
EGG_PORT=8080

# ---------- 数据库（本机 MySQL 8.4） ----------
# 后端直接连本机的 MySQL，不经 Docker。库与账号要先在 MySQL 里建好（见 doc/本地启动指南-无Docker.md 第 2 节），
# 这里的值要与建的一致。密码请换成你自己的（不要含空格、引号、# 与 $）。
# MySQL 只给本机用时，让它只听 127.0.0.1（bind-address=127.0.0.1），不要对外开放 3306。
EGG_DB_HOST=127.0.0.1
EGG_DB_PORT=3306
EGG_DB_NAME=egg
EGG_DB_USER=root
EGG_DB_PASSWORD=123456
# root 密码只有 deploy/backup.sh 用（mysqldump 导出存储过程要 root 权限）。
EGG_DB_ROOT_PASSWORD=change-me-root
# 也可以不用上面四项，直接给完整的 JDBC 地址（给了就以它为准）：
# EGG_DB_URL=jdbc:mysql://127.0.0.1:3306/egg?characterEncoding=utf8&connectionTimeZone=Asia/Shanghai

# ---------- 好生意 ----------
# fake：模拟好生意（档案是演示数据，回传默认成功）。real：连真实好生意，要填下面的密钥。
# real 下没填全时服务照常启动，同步与回传会提示缺哪几项（回传失败，不影响收蛋）。
CHANJET_MODE=real
CHANJET_BASE_URL=https://openapi.chanjet.com
# 开放平台“自建应用”的 appKey、appSecret，以及要入库的账套 ID。
CHANJET_APP_KEY=QwNE3sPm
CHANJET_APP_SECRET=BC89EF6EFDA836B82F08DFEDFA0F3118
CHANJET_BOOK_ID=3287237344233925
# openToken 怎么取（CHANJET_TOKEN_MODE），看开放平台里自建应用的“Token 安全级别”：
#   auto（默认）：CHANJET_ENCRYPT_KEY 与 CHANJET_CERTIFICATE 都填了按 ticket；只填了软证书按 certificate；
#                 否则用 CHANJET_OPEN_TOKEN；
#   ticket：安全级别“高”。开放平台约每 10 分钟把 appTicket 推到 https://<本站域名>/api/chanjet/ticket，
#           后端用 appTicket + 软证书换 token、存进数据库，快到期先用 refreshToken 续；
#           要公网 HTTPS 地址、消息加解密密钥、校验文件（放 deploy/chanjet-check/），步骤见《移交与适配指南》5.3；
#   certificate：安全级别“中/低”，只用软证书换 token（“中”还要把本服务器公网 IP 加进白名单）；
#   static：直接用 CHANJET_OPEN_TOKEN，过期后换新值重启。
CHANJET_TOKEN_MODE=ticket
# 开放平台给自建应用的“消息加解密密钥”（安全级别“高”才用），原样粘贴。
CHANJET_ENCRYPT_KEY=lsglsglsglsglsgl
# 软证书（应用管理员授权后得到的加密证书，一长串字符，原样粘贴）。
CHANJET_CERTIFICATE=Jf+LmYUqM4F0mCc3pvFY8srH7xX16ATlDb9JNRko1r8uwwZ9fU+Eh5PGCradX2D7GRuvwPVGaMKri+HCZvHWo4IhHuVA2gPpSqW9Pwqecx61/6GQJUl7RvjkYtCFRsErhslSsQlMmeK63Pdl/GqT/5cpHTo+o1WXSxbce4s6JSQnpqR0C7ayYUDwKuEIYj+Q

# ---------- 演示数据（开发规格 7.3） ----------
# 库里没有业务数据时，启动写入一套与原型一致的数据；已有数据就不再写。
# 本示例默认 true（模拟模式）；deploy/run-backend.sh 在 .env 里没有这一项时按 false 处理（正式部署）。
EGG_SEED_DEMO=true
#
# 演示账号（只在演示数据里存在，密码是公开的，不要用于正式部署）：
#   磅秤员  张师傅  13900001111  scale-demo-1234
#   磅秤员  刘师傅  13900003333  scale-demo-1234（演示数据里是停用状态）
#   管理员  王会计  13900002222  admin-demo-1234

# ---------- 初始管理员（开发规格 7.2） ----------
# 启动时库里没有任何管理员才建一个；已有管理员就不再起作用（改这里不会改已有管理员的密码）。
# 正式部署必填，否则没人能登录 Web。姓名含中文时，运行后端的环境要用 UTF-8 区域设置，
# deploy/run-backend.sh 里已设好（LANG=C.UTF-8）。
# 演示数据本身带了管理员（王会计），开着演示数据时这三项可以不填。
EGG_ADMIN_PHONE=
EGG_ADMIN_PASSWORD=
EGG_ADMIN_NAME=管理员

# ---------- 上线前改这些 ----------
# 1) EGG_DB_PASSWORD、EGG_DB_ROOT_PASSWORD 换成自己的；
# 2) EGG_SEED_DEMO=false（演示账号密码是公开的）；
# 3) 填 EGG_ADMIN_PHONE、EGG_ADMIN_PASSWORD；
# 4) 要连真实好生意时 CHANJET_MODE=real，填 appKey、appSecret、账套 ID 与软证书（或 openToken）
#    （未经实物验证，见《移交与适配指南》5.3）；
# 5) 设每日备份，见 deploy/backup.cron.example。
# 注意：数据库密码只在第一次建库时生效；库建好后再改 .env 里的数据库密码，不会改库里已有的账号，
# 要改请进库里改（ALTER USER），或把 .env 改回原来的密码。
