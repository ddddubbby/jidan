# 环境变量示例：复制为 deploy/.env 后按需修改（.env 不入库，里面的密码不要提交）。
#   cp deploy/.env.example deploy/.env
# 部署（compose.yml）与开发库（compose.dev.yml）读同一个 .env。下面的值开箱即是“模拟模式”：
# 带演示数据、好生意用模拟实现，用来试跑与演练。正式上线要改的项在文末“上线前改这些”。

# ---------- 站点 ----------
# 站点对外的端口。手机与浏览器都访问 http://<服务器地址>:这个端口（80 时可省略端口）。
EGG_WEB_PORT=80

# ---------- 数据库 ----------
# 数据库不对外开放端口，只有后端在 compose 内部连它。密码请换成你自己的（不要含空格、引号、# 与 $）。
EGG_DB_NAME=egg
EGG_DB_USER=egg
EGG_DB_PASSWORD=change-me-db
EGG_DB_ROOT_PASSWORD=change-me-root
# 只有开发库（compose.dev.yml）用：映射到本机的端口。后端另读 EGG_DB_URL（默认连本机 3306 的 egg 库），
# 端口改了时要把 EGG_DB_URL 里的端口一起改。部署（compose.yml）不读它。
EGG_DB_PORT=3306

# ---------- 好生意 ----------
# fake：模拟好生意（档案是演示数据，回传默认成功）。real：连真实好生意，要填下面四项密钥。
# real 下四项没填时服务照常启动，同步与回传会提示缺哪几项（回传失败，不影响收蛋）。
CHANJET_MODE=fake
CHANJET_BASE_URL=https://openapi.chanjet.com
CHANJET_APP_KEY=
CHANJET_APP_SECRET=
CHANJET_BOOK_ID=
CHANJET_OPEN_TOKEN=

# ---------- 演示数据（开发规格 7.3） ----------
# 库里没有业务数据时，启动写入一套与原型一致的数据；已有数据就不再写。
# 本示例默认 true（模拟模式）；compose.yml 在 .env 里没有这一项时按 false 处理（正式部署）。
EGG_SEED_DEMO=true
#
# 演示账号（只在演示数据里存在，密码是公开的，不要用于正式部署）：
#   磅秤员  张师傅  13900001111  scale-demo-1234
#   磅秤员  刘师傅  13900003333  scale-demo-1234（演示数据里是停用状态）
#   管理员  王会计  13900002222  admin-demo-1234

# ---------- 初始管理员（开发规格 7.2） ----------
# 启动时库里没有任何管理员才建一个；已有管理员就不再起作用（改这里不会改已有管理员的密码）。
# 正式部署必填，否则没人能登录 Web。姓名含中文时，运行后端的环境要用 UTF-8 区域设置，
# compose.yml 里已设好（LANG=C.UTF-8）。
# 演示数据本身带了管理员（王会计），开着演示数据时这三项可以不填。
EGG_ADMIN_PHONE=
EGG_ADMIN_PASSWORD=
EGG_ADMIN_NAME=管理员

# ---------- 上线前改这些 ----------
# 1) EGG_DB_PASSWORD、EGG_DB_ROOT_PASSWORD 换成自己的；
# 2) EGG_SEED_DEMO=false（演示账号密码是公开的）；
# 3) 填 EGG_ADMIN_PHONE、EGG_ADMIN_PASSWORD；
# 4) 要连真实好生意时 CHANJET_MODE=real 并填四项密钥（未经实物验证，见《移交与适配指南》）；
# 5) 设每日备份，见 deploy/backup.cron.example。
# 注意：数据库密码只在第一次建库时生效；库建好后再改 .env 里的数据库密码，不会改库里已有的账号，
# 要改请进库里改，或删掉数据卷重建（会丢数据）。
