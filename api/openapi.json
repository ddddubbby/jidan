{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "鸡蛋采购入库系统 API",
    "version" : "0.1.0"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "paths" : {
    "/api/accounts/{id}/enabled" : {
      "put" : {
        "tags" : [ "account-controller" ],
        "operationId" : "setEnabled",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/EnabledChange"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AccountView"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login" : {
      "post" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "login",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/LoginRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/LoginResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts" : {
      "get" : {
        "tags" : [ "account-controller" ],
        "operationId" : "list",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AccountView"
                  }
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "account-controller" ],
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/NewAccount"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WithPassword"
                }
              }
            }
          }
        }
      }
    },
    "/api/accounts/{id}/reset-password" : {
      "post" : {
        "tags" : [ "account-controller" ],
        "operationId" : "resetPassword",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "integer",
            "format" : "int64"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WithPassword"
                }
              }
            }
          }
        }
      }
    },
    "/api/health" : {
      "get" : {
        "tags" : [ "health-controller" ],
        "operationId" : "health",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me" : {
      "get" : {
        "tags" : [ "auth-controller" ],
        "operationId" : "me",
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/CurrentUser"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "EnabledChange" : {
        "type" : "object",
        "properties" : {
          "enabled" : {
            "type" : "boolean"
          }
        },
        "required" : [ "enabled" ]
      },
      "AccountView" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "phone" : {
            "type" : "string"
          },
          "enabled" : {
            "type" : "boolean"
          },
          "lastLoginAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "LoginRequest" : {
        "type" : "object",
        "properties" : {
          "phone" : {
            "type" : "string",
            "minLength" : 1
          },
          "password" : {
            "type" : "string",
            "minLength" : 1
          },
          "client" : {
            "type" : "string",
            "enum" : [ "APP", "WEB" ]
          }
        },
        "required" : [ "client", "password", "phone" ]
      },
      "LoginResult" : {
        "type" : "object",
        "properties" : {
          "token" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "SCALE", "ADMIN" ]
          }
        }
      },
      "NewAccount" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "minLength" : 1
          },
          "phone" : {
            "type" : "string",
            "minLength" : 1,
            "pattern" : "1\\d{10}"
          }
        },
        "required" : [ "name", "phone" ]
      },
      "WithPassword" : {
        "type" : "object",
        "properties" : {
          "account" : {
            "$ref" : "#/components/schemas/AccountView"
          },
          "password" : {
            "type" : "string"
          }
        }
      },
      "Health" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string"
          },
          "db" : {
            "type" : "string"
          }
        }
      },
      "CurrentUser" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int64"
          },
          "name" : {
            "type" : "string"
          },
          "phone" : {
            "type" : "string"
          },
          "role" : {
            "type" : "string",
            "enum" : [ "SCALE", "ADMIN" ]
          }
        }
      }
    }
  }
}
