          { "seq": 2, "group": 1, "k": 3, "netKg": 46, "tareKg": 2, "grossKg": 48, "atEvent": 2 },
          { "seq": 3, "group": 1, "k": 3, "netKg": 46, "tareKg": 2, "grossKg": 48, "atEvent": 2 }
        ]
      }
    }
