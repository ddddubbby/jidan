        {"grossJin": 97, "stable": false},
        {"grossJin": 97, "stable": true},
        {"grossJin": 0, "stable": true},
        {"grossJin": 95.6, "stable": false},
        {"grossJin": 95.6, "stable": true},
        {"grossJin": 0, "stable": true},
        {"grossJin": 96, "stable": false},
        {"grossJin": 96, "stable": true},
