        { "grossKg": 47.6, "stable": true },
        { "grossKg": 0, "stable": true },
        { "grossKg": 47.6, "stable": false },
        { "grossKg": 47.6, "stable": true },
        { "grossKg": 0, "stable": true },
        { "grossKg": 47.6, "stable": false },
        { "grossKg": 47.6, "stable": true },
        { "grossKg": 0, "stable": true },
        { "grossKg": 49.8, "stable": false },
        { "grossKg": 49.8, "stable": true }
