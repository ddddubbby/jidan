    {
      "id": "merge-three-boxes",
      "source": "v7 6.7",
      "desc": "一次放 3 箱：记出 3 条 46kg，共用一个称重组号",
      "setup": {
        "tareKg": 2,
        "standardNetKg": 45,
        "options": {
          "scale.stable-by": "sdk",
          "weigh.record-by": "auto",
