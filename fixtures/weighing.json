        { "grossKg": 47.8, "stable": false },
        { "grossKg": 47.8, "stable": true },
        { "grossKg": 0, "stable": true },
        { "grossKg": 48, "stable": false },
        { "grossKg": 48, "stable": true },
        { "grossKg": 0, "stable": true },
        { "grossKg": 48, "stable": false },
        { "grossKg": 48, "stable": true },
        { "grossKg": 0, "stable": true },
        { "grossKg": 48, "stable": false },
        { "grossKg": 48, "stable": true },
