{
  "说明": "回传备注的组装。maxLength 对应选项 push.remark-max-length，0 表示不限；完整备注超过上限时只保留“共N箱”与归类段，两段间仍用“；”。归类按箱数多的在前，箱数相同按首次出现的箱序号；按记录值归并，不另行舍入；重量去掉末尾的 0。groups 是归类的结构化结果（kg 为每箱净重，boxes 为箱数），text 是备注全文。",
  "cases": [
    {
      "id": "v7-6.3",
      "source": "v7 6.3",
      "desc": "10 箱粉蛋的完整备注，不限长度",
      "input": { "boxNetKg": [46.5, 45.8, 46, 46, 46, 45.6, 45.6, 45.6, 45.6, 47.8], "maxLength": 0 },
      "expected": {
        "text": "共10箱；逐箱：46.5,45.8,46,46,46,45.6,45.6,45.6,45.6,47.8；归类：45.6kg-4箱,46kg-3箱,46.5kg-1箱,45.8kg-1箱,47.8kg-1箱",
        "truncated": false,
        "groups": [
          { "kg": 45.6, "boxes": 4 },
          { "kg": 46, "boxes": 3 },
          { "kg": 46.5, "boxes": 1 },
          { "kg": 45.8, "boxes": 1 },
          { "kg": 47.8, "boxes": 1 }
        ]
      }
    },
    {
      "id": "v7-5.3-truncated",
      "source": "v7 5.3",
      "desc": "超过长度上限（比完整备注短 1 个字符）：只留“共N箱”与归类段",
      "input": { "boxNetKg": [46.5, 45.8, 46, 46, 46, 45.6, 45.6, 45.6, 45.6, 47.8], "maxLength": 101 },
      "expected": {
        "text": "共10箱；归类：45.6kg-4箱,46kg-3箱,46.5kg-1箱,45.8kg-1箱,47.8kg-1箱",
        "truncated": true,
        "groups": [
          { "kg": 45.6, "boxes": 4 },
          { "kg": 46, "boxes": 3 },
          { "kg": 46.5, "boxes": 1 },
          { "kg": 45.8, "boxes": 1 },
          { "kg": 47.8, "boxes": 1 }
        ]
      }
    },
    {
      "id": "extra-fits-limit",
      "source": "补充（非 v7）",
      "desc": "长度上限恰好等于完整备注的长度：不截断",
      "input": { "boxNetKg": [46.5, 45.8, 46, 46, 46, 45.6, 45.6, 45.6, 45.6, 47.8], "maxLength": 102 },
      "expected": {
        "text": "共10箱；逐箱：46.5,45.8,46,46,46,45.6,45.6,45.6,45.6,47.8；归类：45.6kg-4箱,46kg-3箱,46.5kg-1箱,45.8kg-1箱,47.8kg-1箱",
        "truncated": false,
        "groups": [
          { "kg": 45.6, "boxes": 4 },
          { "kg": 46, "boxes": 3 },
          { "kg": 46.5, "boxes": 1 },
          { "kg": 45.8, "boxes": 1 },
          { "kg": 47.8, "boxes": 1 }
        ]
      }
    },
    {
      "id": "extra-tie-first-seen",
      "source": "补充（非 v7）",
      "desc": "箱数相同按首次出现的箱序号：45.6 先出现，排在 46 前面（按重量排会反过来）",
      "input": { "boxNetKg": [45.6, 46, 46, 45.6, 47], "maxLength": 0 },
      "expected": {
        "text": "共5箱；逐箱：45.6,46,46,45.6,47；归类：45.6kg-2箱,46kg-2箱,47kg-1箱",
        "truncated": false,
        "groups": [
          { "kg": 45.6, "boxes": 2 },
          { "kg": 46, "boxes": 2 },
          { "kg": 47, "boxes": 1 }
        ]
      }
    }
  ]
}
