<?xml version="1.0" encoding="utf-8"?>
<!-- 对照 lab/app-sim.html screenLogin；另加服务器地址与新版本入口（开发规格 9.4、附录 B.5） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="64dp">

            <!-- 品牌：蛋形 40×50 + “收蛋” 26 号加粗、字距 0.04em -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="36dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="50dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_brand_egg" />

                <TextView
                    style="@style/Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:letterSpacing="0.04"
                    android:text="@string/brand_name" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 服务器地址：APP 独有（原型没有），样式与其他字段一致；地址长，字号小一档 -->
                <TextView
                    style="@style/Text.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/serverUrl"
                    android:text="@string/login_server" />

                <EditText
                    android:id="@+id/serverUrl"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_large_height"
                    android:layout_marginTop="6dp"
                    android:hint="@string/login_server_hint"
                    android:inputType="textUri"
                    android:textSize="@dimen/text_17" />

                <TextView
                    style="@style/Text.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:labelFor="@id/phone"
                    android:text="@string/login_phone" />

                <EditText
                    android:id="@+id/phone"
                    style="@style/Input"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/input_large_height"
                    android:layout_marginTop="6dp"
                    android:autofillHints="username"
                    android:fontFamily="@font/inter_medium"
                    android:importantForAutofill="auto"
                    android:inputType="phone" />

                <TextView
                    style="@style/Text.FieldLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:labelFor="@id/password"
                    android:text="@string/login_password" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp">

                    <EditText
                        android:id="@+id/password"
                        style="@style/Input"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/input_large_height"
                        android:autofillHints="password"
                        android:importantForAutofill="auto"
                        android:inputType="textPassword"
                        android:paddingEnd="56dp" />

                    <ImageButton
                        android:id="@+id/togglePassword"
                        android:layout_width="@dimen/button_small_height"
                        android:layout_height="@dimen/button_small_height"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/login_show_password"
                        android:padding="10dp"
                        android:src="@drawable/ic_eye" />
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/error"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"
                android:minHeight="22dp"
                android:textColor="@color/err_ink" />

            <TextView
                android:id="@+id/updateEntry"
                style="@style/Text.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_update_chip"
                android:padding="12dp"
                android:textColor="@color/ok_ink"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/action"
            style="@style/Widget.Jidan.Button.Action"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_large_height" />
    </FrameLayout>
</LinearLayout>
