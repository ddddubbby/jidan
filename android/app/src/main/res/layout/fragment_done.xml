<?xml version="1.0" encoding="utf-8"?>
<!-- 对照 lab/app-sim.html screenDone：偏上居中，只有对勾动一下 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="72dp">

            <FrameLayout
                android:id="@+id/check"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_done_check">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_check" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/done_submitted" />

                <TextView
                    style="@style/Tagline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/done_pending" />
            </LinearLayout>

            <TextView
                android:id="@+id/name"
                style="@style/Text.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center" />

            <!-- 金额：Inter 大数字 + 小一档的“元”，按基线对齐；字号按位数缩小（原型 .amt） -->
            <LinearLayout
                android:id="@+id/amountRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:baselineAligned="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/amountValue"
                    style="@style/Text.Num.Amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/amountUnit"
                    style="@style/Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/summary_yuan"
                    android:textColor="@color/ink_2"
                    android:textStyle="normal" />
            </LinearLayout>

            <TextView
                android:id="@+id/pendingPrice"
                style="@style/Text.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/done_pending_price"
                android:textColor="@color/warn_ink"
                android:visibility="gone" />

            <!-- “商品 规格 · N 箱 ›”：点开流水（原型 .done-line） -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/ledgerLine"
                style="@style/Widget.Jidan.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/inter_semibold"
                android:minHeight="@dimen/button_small_height"
                android:textColor="@color/ink"
                android:textSize="@dimen/text_17"
                app:icon="@drawable/ic_chevron_right"
                app:iconGravity="textEnd"
                app:iconPadding="2dp"
                app:iconSize="20dp"
                app:iconTint="@null" />

            <TextView
                android:id="@+id/sub"
                style="@style/Text.Num.Lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center" />

            <TextView
                android:id="@+id/batch"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/printProgress"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- 提交后还能补打：打印机有问题时写明缺什么，点了去设备弹层 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reprint"
                style="@style/Widget.Jidan.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/again"
            style="@style/Widget.Jidan.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/done_again" />
    </FrameLayout>
</LinearLayout>
