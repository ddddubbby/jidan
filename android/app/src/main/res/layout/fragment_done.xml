<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/page_padding"
            android:paddingTop="48dp">

            <TextView
                android:id="@+id/check"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_done_check"
                android:gravity="center"
                android:text="✓"
                android:textColor="@color/on_accent"
                android:textSize="34sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Text.Value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/done_submitted" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_choice"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/done_pending"
                    android:textColor="@color/ink_2"
                    android:textSize="@dimen/text_13" />
            </LinearLayout>

            <TextView
                android:id="@+id/name"
                style="@style/Text.Value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center" />

            <LinearLayout
                android:id="@+id/amountRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/amountValue"
                    style="@style/Text.Num.Amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="48sp" />

                <TextView
                    android:id="@+id/amountUnit"
                    style="@style/Text.Strong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/summary_yuan"
                    android:textColor="@color/ink_2" />
            </LinearLayout>

            <TextView
                android:id="@+id/pendingPrice"
                style="@style/Text.Strong"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/done_pending_price"
                android:textColor="@color/warn_ink"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/ledgerLine"
                style="@style/Widget.Jidan.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/ink" />

            <TextView
                android:id="@+id/sub"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center" />

            <TextView
                android:id="@+id/batch"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/printProgress"
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:visibility="gone" />

            <!-- 提交后还能补打：打印机有问题时写明缺什么，点了去设备弹层 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/reprint"
                style="@style/Widget.Jidan.Button.Outlined"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="52dp"
                android:visibility="gone" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/page_padding">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/again"
            style="@style/Widget.Jidan.Button.Large"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:text="@string/done_again" />
    </FrameLayout>
</LinearLayout>
