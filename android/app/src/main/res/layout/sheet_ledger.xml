<?xml version="1.0" encoding="utf-8"?>
<!-- 对照 lab/app-sim.html sheetLog：收购流水 · N 箱 / 相同重量归类 / 皮重 / 手工加一箱 / 表（箱序号、净重、标签）。
     上百箱时整块在弹层里滚动，不撑破（v7 4.4-6） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/head"
        layout="@layout/view_sheet_head" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_padding"
            android:paddingEnd="@dimen/page_padding"
            android:paddingBottom="20dp">

            <TextView
                android:id="@+id/groupsLabel"
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ledger_groups_label" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp" />

            <!-- 重量种类超过 8 种：先列 6 种，点开看全部（原型 sheetLog） -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/groupsToggle"
                style="@style/Widget.Jidan.Button.Outlined.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tareSame"
                style="@style/Text.Section"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:fontFamily="sans-serif"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/manualAdd"
                style="@style/Widget.Jidan.Button.Outlined.Small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/ledger_manual_add" />

            <!-- 表头 -->
            <LinearLayout
                android:id="@+id/tableHead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal"
                android:paddingVertical="8dp">

                <TextView
                    style="@style/Text.FieldLabel"
                    android:layout_width="76dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:text="@string/ledger_col_seq" />

                <TextView
                    style="@style/Text.FieldLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingStart="4dp"
                    android:text="@string/ledger_col_net" />

                <TextView
                    android:id="@+id/colLabel"
                    style="@style/Text.FieldLabel"
                    android:layout_width="116dp"
                    android:layout_height="wrap_content"
                    android:paddingStart="4dp"
                    android:text="@string/ledger_col_label" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:divider="@drawable/bg_hairline"
                android:orientation="vertical"
                android:showDividers="beginning|middle" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
