<?xml version="1.0" encoding="utf-8"?>
<!-- 对照 lab/app-sim.html sheetLeave：放弃这一单？ / 已称的 N 箱记录会全部删除。 / 放弃这一单（红字红边）、继续称（墨底）。
     确认类弹层只有两个答案，没有“关闭” -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <include
        android:id="@+id/head"
        layout="@layout/view_sheet_head" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/page_padding"
        android:paddingEnd="@dimen/page_padding"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/leaveMessage"
            style="@style/Text.Row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/abandon"
                style="@style/Widget.Jidan.Button.Outlined.Danger"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:text="@string/weigh_abandon" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/keepWeighing"
                style="@style/Widget.Jidan.Button.Dark"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:text="@string/weigh_leave_continue" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
