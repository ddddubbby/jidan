<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 只做浅色主题：原型没有深色版 -->
    <style name="Theme.Jidan" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/accent_press</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorError">@color/err_ink</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/ink_2</item>
        <item name="android:textColorHint">@color/ink_3</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="shapeAppearanceMediumComponent">@style/Shape.Control</item>

        <!-- 按钮：Material 默认的字距（0.09em）和全大写对中文是错的，主题里统一去掉；
             三种按钮的默认样式换成原型的（styles.xml） -->
        <item name="textAppearanceButton">@style/TextAppearance.Jidan.Button</item>
        <item name="materialButtonStyle">@style/Widget.Jidan.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Jidan.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.Jidan.Button.Text</item>
    </style>

    <style name="Shape.Control" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">@dimen/radius_control</item>
    </style>
</resources>
