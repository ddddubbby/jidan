<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- 任何页面登录失效都走这一条（MainActivity）；清空回退栈，只留登录页 -->
    <action
        android:id="@+id/action_global_to_login"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <!-- 仅演示版用（退出登录后回到空白建单页，没有登录页） -->
    <action
        android:id="@+id/action_global_to_create"
        app:destination="@id/createFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.jidan.receiving.ui.login.LoginFragment"
        android:label="@string/brand_name">
        <argument
            android:name="expired"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_login_to_create"
            app:destination="@id/createFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/createFragment"
        android:name="com.jidan.receiving.ui.create.CreateFragment"
        android:label="@string/create_title">
        <action
            android:id="@+id/action_create_to_weigh"
            app:destination="@id/weighFragment" />
    </fragment>

    <fragment
        android:id="@+id/weighFragment"
        android:name="com.jidan.receiving.ui.weigh.WeighFragment"
        android:label="@string/create_title">
        <action
            android:id="@+id/action_weigh_to_create"
            app:destination="@id/createFragment"
            app:popUpTo="@id/createFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_weigh_to_summary"
            app:destination="@id/summaryFragment" />
    </fragment>

    <fragment
        android:id="@+id/summaryFragment"
        android:name="com.jidan.receiving.ui.summary.SummaryFragment"
        android:label="@string/summary_amount">
        <action
            android:id="@+id/action_summary_to_weigh"
            app:destination="@id/weighFragment"
            app:popUpTo="@id/weighFragment"
            app:popUpToInclusive="false" />
        <action
            android:id="@+id/action_summary_to_done"
            app:destination="@id/doneFragment"
            app:popUpTo="@id/createFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/doneFragment"
        android:name="com.jidan.receiving.ui.done.DoneFragment"
        android:label="@string/done_submitted">
        <action
            android:id="@+id/action_done_to_create"
            app:destination="@id/createFragment"
            app:popUpTo="@id/createFragment"
            app:popUpToInclusive="true" />
    </fragment>
</navigation>
